---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Diferenciales from '../components/Diferenciales.astro';
import Proceso from '../components/Proceso.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Foto from '../components/Foto.astro';
import { negocio, textos, servicios, zonas, serviciosConLanding, url, listaNatural, schemaFaq } from '../lib/sitio';
import { guias } from '../lib/guias';

const principal = serviciosConLanding[0] ?? servicios[0];
const ciudad = negocio.ciudad;
const faq = [
  { p: '¿Qué sois exactamente?', r: negocio.queSomos },
  { p: '¿Cuánto cuesta pedir presupuesto?', r: 'Nada. Pedir presupuesto es gratis y no te obliga a contratar.' },
  { p: `¿En qué zonas de ${ciudad} hay reformistas?`, r: `En ${listaNatural(zonas.map((z) => z.nombre))}.` },
  ...servicios.slice(0, 2).map((s) => s.faq[0]),
];
---
<Base titulo={`${principal.nombreCorto} en ${ciudad}: presupuestos gratis | ${negocio.nombreCorto}`} descripcion={negocio.descripcion.slice(0, 160)} schemas={[schemaFaq(faq)]}>
  <Hero titulo={`${principal.nombreCorto} en ${ciudad}: pide presupuesto gratis`} subtitulo={negocio.eslogan} foto="portada" />

  <Proceso titulo="Cómo funciona" />

  <section class="seccion seccion--blanca">
    <div class="contenedor">
      <h2>¿Qué reforma necesitas?</h2>
      <div class="rejilla">
        {servicios.map((s) => (
          <article class="tarjeta tarjeta--foto">
            <Foto clave={s.foto} credito={false} sizes="(max-width: 760px) 100vw, 280px" />
            <h3><a href={url.servicio(s)}>{s.nombre}</a></h3>
            <p>{s.resumen}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <h2>Guías antes de reformar</h2>
      <div class="rejilla">
        {guias.map((g) => (
          <article class="tarjeta">
            <h3><a href={g.ruta}>{g.titulo}</a></h3>
            <p>{g.descripcion}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion seccion--blanca">
    <div class="contenedor">
      <h2>Zonas</h2>
      <p class="lead">Reformistas en {ciudad} capital y en los municipios de alrededor.</p>
      <div class="rejilla">
        {zonas.map((z) => (
          <article class="tarjeta">
            <h3><a href={url.landing(principal, z)}>{principal.nombreCorto} en {z.nombre}</a></h3>
            <p>{listaNatural(z.lugares.slice(0, 4))}{z.lugares.length > 4 ? ' y alrededores' : ''}.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Diferenciales titulo="Por qué pedir presupuesto aquí" />
  <Faq faq={faq} />
  <Cta titulo={textos.ctaTitulo} />
</Base>
