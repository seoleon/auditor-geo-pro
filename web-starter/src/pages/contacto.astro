---
import Base from '../layouts/Base.astro';
import { negocio, textos, url, telHref, whatsappHref } from '../lib/sitio';
const migas = [{ nombre: 'Inicio', ruta: url.inicio }, { nombre: 'Contacto', ruta: url.contacto }];
const wa = whatsappHref(textos.mensajeWhatsapp);
---
<Base titulo={`Contacto | ${negocio.nombre}`} descripcion={`Contacta con ${negocio.nombre}: teléfono ${negocio.telefonoVisible}, WhatsApp o email. Presupuestos de reforma de baño en ${negocio.ciudad}.`} migas={migas}>
  <section class="seccion">
    <div class="contenedor">
      <h1>Contacto</h1>
      <p class="lead">Para pedir presupuesto, lo más rápido es el <a href={url.presupuesto}>formulario</a>. También puedes llamarnos o escribirnos.</p>
      <div class="rejilla">
        <div class="tarjeta">
          <h2>Teléfono y WhatsApp</h2>
          <p><a class="boton boton--primario" href={telHref}>{negocio.telefonoVisible}</a></p>
          {wa && <p><a href={wa} rel="nofollow">Escríbenos por WhatsApp</a></p>}
          <ul>{negocio.horario.map((h) => <li>{h.texto}</li>)}</ul>
        </div>
        <div class="tarjeta">
          <h2>Email</h2>
          <p><a href={`mailto:${negocio.email}`}>{negocio.email}</a></p>
          <p>{negocio.queSomos}</p>
        </div>
      </div>
    </div>
  </section>
</Base>
