---
import { negocio, textos, url, telHref, whatsappHref } from '../lib/sitio';
interface Props { titulo: string; mensajeWhatsapp?: string; }
const { titulo, mensajeWhatsapp = textos.mensajeWhatsapp } = Astro.props;
const wa = whatsappHref(mensajeWhatsapp);
---
<section class="cta">
  <div class="contenedor">
    <h2>{titulo}</h2>
    <p>{textos.ctaTexto}</p>
    <div class="botones">
      <a class="boton boton--primario" href={url.presupuesto}>Pedir presupuesto gratis</a>
      <a class="boton boton--secundario" href={telHref}>Llamar al {negocio.telefonoVisible}</a>
      {wa && <a class="boton boton--secundario" href={wa} rel="nofollow">WhatsApp</a>}
    </div>
  </div>
</section>
<style>
  .cta { background: var(--c-primario); color: #fff; padding-block: clamp(40px, 7vw, 72px); }
</style>
