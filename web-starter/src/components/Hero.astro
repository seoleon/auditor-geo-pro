---
import Foto from './Foto.astro';
import { negocio, textos, url, telHref } from '../lib/sitio';
interface Props { titulo: string; subtitulo: string; foto?: string; }
const { titulo, subtitulo, foto } = Astro.props;
---
<section class:list={['hero', { 'hero--foto': foto }]}>
  <div class="contenedor hero__rejilla">
    <div>
      <h1>{titulo}</h1>
      <p class="hero__sub">{subtitulo}</p>
      <div class="botones">
        <a class="boton boton--primario" href={url.presupuesto}>Pedir presupuesto gratis</a>
        <a class="boton boton--secundario" href={telHref}>Llamar al {negocio.telefonoVisible}</a>
      </div>
      <ul class="hero__datos">
        {textos.sellosHero.map((t) => <li>{t}</li>)}
      </ul>
    </div>
    {foto && <Foto clave={foto} prioridad credito={false} sizes="(max-width: 900px) 100vw, 520px" class="hero__foto" />}
  </div>
</section>
<style>
  .hero { background: linear-gradient(135deg, var(--c-primario), color-mix(in srgb, var(--c-primario) 70%, #000)); color: #fff; padding-block: clamp(40px, 8vw, 88px); }
  .hero h1 { max-width: 22ch; }
  .hero__sub { font-size: 1.2rem; max-width: 60ch; opacity: .92; }
  .hero__datos { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: .95rem; opacity: .9; }
  .hero__datos li::before { content: '✓ '; }
  .hero__rejilla { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 900px) { .hero--foto .hero__rejilla { grid-template-columns: 1.15fr .85fr; } }
  .hero :global(.hero__foto) { margin: 0; }
  .hero :global(.hero__foto img) { aspect-ratio: 4 / 3; box-shadow: 0 18px 40px rgb(0 0 0 / .25); }
</style>
