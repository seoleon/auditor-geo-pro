---
import { negocio, servicios, url } from '../lib/sitio';
---
<header class="cabecera">
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <div class="contenedor cabecera__fila">
    <a class="logo" href="/">{negocio.nombreCorto}</a>
    <nav aria-label="Principal">
      <ul>
        {servicios.map((s) => <li><a href={url.servicio(s)}>{s.nombreCorto}</a></li>)}
        <li><a href={url.guias}>Guías</a></li>
        <li><a href={url.comoFunciona}>Cómo funciona</a></li>
      </ul>
    </nav>
    <a class="boton boton--primario cabecera__cta" href={url.presupuesto}>Pedir presupuesto</a>
  </div>
</header>
<style>
  .cabecera { background: var(--c-blanco); border-bottom: 1px solid var(--c-borde); }
  .cabecera__fila { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding-block: 12px; }
  .logo { font-weight: 800; font-size: 1.2rem; text-decoration: none; color: var(--c-primario); }
  nav { flex: 1 1 auto; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 18px; }
  nav a { color: var(--c-texto); text-decoration: none; font-size: .95rem; }
  nav a:hover { color: var(--c-primario); text-decoration: underline; }
  .cabecera__cta { padding: 9px 16px; font-size: .95rem; }
  .saltar { position: absolute; left: -9999px; }
  .saltar:focus { left: 16px; top: 8px; background: var(--c-blanco); padding: 8px; z-index: 10; }
  @media (max-width: 760px) { nav { order: 3; flex-basis: 100%; } nav ul { gap: 4px 14px; } }
</style>
