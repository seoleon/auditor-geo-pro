---
import Base from './Base.astro';
import Cta from '../components/Cta.astro';
import Foto from '../components/Foto.astro';
import { getImage } from 'astro:assets';
import { url, absoluta, schemaArticulo, schemaFaq, textos } from '../lib/sitio';
import { foto } from '../lib/fotos';
import { guias } from '../lib/guias';

const { frontmatter, headings = [] } = Astro.props;
const { titulo, tituloSeo, descripcion, publicado, actualizado, fuentes = [], faq = [], foto: claveFoto = 'portada' } = frontmatter;
const ruta = Astro.url.pathname;
const migas = [
  { nombre: 'Inicio', ruta: url.inicio },
  { nombre: 'Guías', ruta: url.guias },
  { nombre: titulo, ruta },
];
const indice = headings.filter((h: { depth: number }) => h.depth === 2);
const relacionadas = guias.filter((g) => g.ruta !== ruta).slice(0, 4);
const img = await getImage({ src: foto(claveFoto).src, width: 1200, format: 'jpg' });
const fecha = (iso: string) => new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  titulo={tituloSeo ?? titulo}
  descripcion={descripcion}
  migas={migas}
  imagen={claveFoto}
  tipoOg="article"
  schemas={[schemaArticulo({ titulo, descripcion, ruta, publicado, actualizado, imagen: absoluta(img.src) }), ...(faq.length ? [schemaFaq(faq)] : [])]}
>
  <article class="seccion">
    <div class="contenedor guia">
      <h1>{titulo}</h1>
      <p class="guia__fecha">Actualizado el <time datetime={actualizado}>{fecha(actualizado)}</time></p>
      <Foto clave={claveFoto} prioridad sizes="(max-width: 800px) 100vw, 760px" />
      {indice.length > 2 && (
        <nav class="guia__indice" aria-label="Índice">
          <p>En esta guía</p>
          <ol>{indice.map((h: { slug: string; text: string }) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <slot />
      {faq.length > 0 && (
        <section>
          <h2 id="preguntas-frecuentes">Preguntas frecuentes</h2>
          {faq.map((f: { p: string; r: string }) => <details><summary>{f.p}</summary><p>{f.r}</p></details>)}
        </section>
      )}
      {fuentes.length > 0 && (
        <section class="guia__fuentes">
          <h2 id="fuentes">Fuentes</h2>
          <ul>{fuentes.map((f: { nombre: string; url: string }) => <li><a href={f.url} rel="nofollow noopener" target="_blank">{f.nombre}</a></li>)}</ul>
        </section>
      )}
      <section class="guia__relacionadas">
        <h2 id="otras-guias">Otras guías para tu reforma</h2>
        <ul>{relacionadas.map((g) => <li><a href={g.ruta}>{g.titulo}</a></li>)}</ul>
      </section>
    </div>
  </article>
  <Cta titulo={textos.ctaTitulo} />
</Base>
<style>
  .guia { max-width: 760px; }
  .guia__fecha { color: var(--c-suave); font-size: .95rem; }
  .guia__indice { background: var(--c-blanco); border: 1px solid var(--c-borde); border-radius: var(--radio); padding: 14px 18px; margin: 0 0 1.6em; }
  .guia__indice p { font-weight: 700; margin: 0 0 6px; }
  .guia__indice ol { margin: 0; padding-left: 20px; }
  .guia :global(h2) { margin-top: 1.6em; scroll-margin-top: 16px; }
  .guia :global(table) { display: block; overflow-x: auto; width: 100%; border-collapse: collapse; margin: 0 0 1.2em; background: var(--c-blanco); font-size: .97rem; }
  .guia :global(th), .guia :global(td) { border: 1px solid var(--c-borde); padding: 8px 10px; text-align: left; vertical-align: top; }
  .guia :global(blockquote) { margin: 0 0 1em; padding: 12px 16px; border-left: 4px solid var(--c-acento); background: var(--c-blanco); }
  .guia :global(ul.contains-task-list) { list-style: none; padding-left: 0; }
  details { border: 1px solid var(--c-borde); border-radius: var(--radio); padding: 12px 16px; background: var(--c-blanco); margin-bottom: 8px; }
  summary { font-weight: 700; cursor: pointer; }
  .guia__fuentes { font-size: .95rem; }
  .guia__fuentes ul, .guia__relacionadas ul { padding-left: 18px; }
</style>
