# ===================== NAP Entity Auditor Pro =====================
# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repositorio.

# --- General ---
ENVIRONMENT=development                 # development | production
SECRET_KEY=                             # obligatoria en producción: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./nap_auditor.db # en Docker se sobrescribe con PostgreSQL
POSTGRES_PASSWORD=                      # solo docker-compose
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false                     # true detrás de HTTPS
ALLOW_SIGNUP=false                      # registro público de organizaciones
ADMIN_EMAIL=admin@example.com           # se crea al arrancar si no hay usuarios
ADMIN_PASSWORD=
ADMIN_ORGANIZATION=Mi agencia

# --- Trabajos y auditorías programadas ---
TASK_BACKEND=thread                     # thread | celery | inline
REDIS_URL=redis://localhost:6379/0
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=3600

# --- Crawler ---
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_BYTES=3000000
CRAWLER_PER_HOST_DELAY_SECONDS=1.0
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_USE_ENV_PROXY=false             # true si el servidor sale a Internet por un proxy (HTTPS_PROXY)
PLAYWRIGHT_ENABLED=false                # requiere requirements-playwright.txt y "playwright install chromium"

# --- Límites y modo económico ---
MAX_QUERIES_PER_AUDIT=30
MAX_PAGES_PER_AUDIT=60
MAX_OFFICIAL_PAGES=8
ECONOMIC_MAX_QUERIES=10
ECONOMIC_MAX_PAGES=20
SEARCH_MONTHLY_QUERY_LIMIT=1000
CACHE_TTL_HOURS=72
ECONOMIC_CACHE_TTL_HOURS=336

# --- Búsqueda web (al menos uno para descubrir menciones) ---
SEARCH_PROVIDERS=brave,serpapi,google_cse,searxng
BRAVE_API_KEY=
BRAVE_COST_PER_1000=                    # tarifa de tu plan, para estimar costes
SERPAPI_API_KEY=
SERPAPI_COST_PER_1000=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_COST_PER_1000=5
SEARXNG_URL=                            # p. ej. http://searxng:8080 (gratuito, autoalojado)

# --- Google ---
GOOGLE_PLACES_API_KEY=                  # Places API (New), datos públicos
GOOGLE_PLACES_COST_PER_1000=
GBP_CLIENT_ID=                          # Business Profile: solo con OAuth del propietario
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# --- Pruebas en buscadores de IA (opcional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Rate limiting ---
LOGIN_RATE_LIMIT_PER_MINUTE=10
AUDIT_RATE_LIMIT_PER_HOUR=30

# --- Frontend (docker-compose) ---
FRONTEND_PORT=3000
