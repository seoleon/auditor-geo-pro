# ============ NAP Entity Auditor Pro — MODO GRATUITO ============
# Copia a .env:  cp .env.free.example .env
# Genera claves:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"

SECRET_KEY=
SEARXNG_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ORGANIZATION=Mi agencia

# true si publicas el panel con HTTPS (recomendado en un servidor)
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000

# Límites prudentes (SearXNG es gratis, pero conviene no saturar a los buscadores que consulta)
MAX_QUERIES_PER_AUDIT=15
MAX_PAGES_PER_AUDIT=40
ECONOMIC_MAX_QUERIES=8
ECONOMIC_MAX_PAGES=20
CACHE_TTL_HOURS=168

# --- Opcional: añade APIs de pago más adelante si las necesitas ---
# GOOGLE_PLACES_API_KEY=
# BRAVE_API_KEY=
# SEARCH_PROVIDERS=searxng,brave
