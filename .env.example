# Keyword Planner · copia este archivo a .env y rellénalo. `npm start` lo carga automáticamente.
# .env está en .gitignore: tus credenciales nunca se suben al repositorio ni salen del servidor.

# --- Google Ads API (gratuita; el acceso Basic permite 15.000 operaciones al día) ---
# Developer token: Google Ads (cuenta de administrador/MCC) → Herramientas → Centro de API.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Cliente OAuth «Aplicación de escritorio» del proyecto de Google Cloud con la Google Ads API activada.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Se genera con `npm run keywords:auth` (lo guarda aquí automáticamente).
GOOGLE_ADS_REFRESH_TOKEN=
# Cuenta de Google Ads que hace las consultas (10 dígitos, con o sin guiones).
GOOGLE_ADS_CUSTOMER_ID=
# Solo si accedes a esa cuenta a través de una MCC: el ID de la MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Versión de la API (opcional). Google publica versiones nuevas cada pocos meses.
# GOOGLE_ADS_API_VERSION=v25

# --- Clasificación con IA (opcional) ---
# Sin clave se usa el clasificador por reglas.
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto claude-opus-5-5; claude-haiku-5-5 es mucho más barato para listas enormes.
# KEYWORDS_AI_MODEL=claude-opus-5-5
# KEYWORDS_AI=0   # desactiva la IA aunque haya clave
